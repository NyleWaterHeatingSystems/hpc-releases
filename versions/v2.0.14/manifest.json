    },
    {
      "since": "v2.0.11-RC2",
      "kind": "warning",
      "area": "firmware",
      "text": "Status packet and alarm bits changed: control and iot must run firmware from the same side of v2.0.11-RC2."
    },
    {
      "since": "v2.0.11-RC2",
      "kind": "warning",
      "area": "gateway",
